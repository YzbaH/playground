#!/usr/bin/env bash
# ==============================================================================
# SAFEGUARD PRE-COMMIT HOOK
# ==============================================================================
# Protege contra commits acidentais de arquivos grandes, credenciais e sub-repos.
# Para ignorar em caso de emergência consciente: git commit --no-verify

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

MAX_FILE_SIZE_MB=25
MAX_FILE_SIZE_BYTES=$((MAX_FILE_SIZE_MB * 1024 * 1024))

FAILED=0

# 1. Checar tamanho dos arquivos commitados
while IFS= read -r file; do
    [ -z "$file" ] && continue
    if [ -f "$file" ]; then
        FILE_SIZE=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
        if [ "$FILE_SIZE" -gt "$MAX_FILE_SIZE_BYTES" ]; then
            FILE_SIZE_MB=$((FILE_SIZE / 1024 / 1024))
            echo -e "${RED}[SAFEGUARD BLOQUEIO] Arquivo muito grande detectado:${NC} $file (${FILE_SIZE_MB}MB > ${MAX_FILE_SIZE_MB}MB)"
            echo -e "${YELLOW}Dica: Arquivos gigantes (datasets, vídeos, modelos) travam o Git. Use nuvem, .gitignore ou adicione ao DVC/LFS.${NC}"
            FAILED=1
        fi
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# 2. Checar arquivos sensíveis (chaves, senhas, .env)
SENSITIVE_PATTERN='(\.env$|\.env\..+|id_rsa|id_ed25519|\.pem$|\.key$|credentials\.json|service-account.*\.json)'
while IFS= read -r file; do
    [ -z "$file" ] && continue
    if [[ "$file" =~ $SENSITIVE_PATTERN ]] && [[ "$file" != *".example"* ]]; then
        echo -e "${RED}[SAFEGUARD BLOQUEIO] Arquivo confidencial detectado:${NC} $file"
        echo -e "${YELLOW}Remova do stage com: git reset HEAD '$file'${NC}"
        FAILED=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# 3. Checar possíveis chaves de API expostas no diff
SECRET_REGEX='(ghp_[a-zA-Z0-9]{36}|sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16})'
if git diff --cached -U0 | grep -E -q "$SECRET_REGEX"; then
    echo -e "${RED}[SAFEGUARD BLOQUEIO] Possível API Key ou token detectado no código!${NC}"
    echo -e "${YELLOW}Verifique as alterações com: git diff --cached${NC}"
    FAILED=1
fi

# 4. Checar se há pastas .git aninhadas (repositórios clonados por engano dentro de pastas)
while IFS= read -r dir; do
    [ -z "$dir" ] && continue
    if [ -d "$dir/.git" ] && [ "$dir" != "." ]; then
        echo -e "${YELLOW}[SAFEGUARD AVISO] Repositório Git interno detectado:${NC} $dir"
        echo -e "O Git vai registrar isso como submódulo ou ignorar o conteúdo interno."
    fi
done < <(find . -mindepth 2 -maxdepth 3 -name ".git" -exec dirname {} \;)

if [ $FAILED -ne 0 ]; then
    echo ""
    echo -e "${RED}Commit cancelado pelos Safeguards do Playground.${NC}"
    echo -e "Se você realmente sabe o que está fazendo e quer forçar o commit, use:"
    echo -e "${BLUE}  git commit --no-verify${NC}"
    exit 1
fi

exit 0
