# ==============================================================================
# PLAYGROUND MONOREPO - MASTER .GITIGNORE
# ==============================================================================

# --- [Segurança & Credenciais] ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_ecdsa
id_ed25519
*.pfx
*.p12
*.kdbx
secrets/
credentials.json
*token*
*.secret

